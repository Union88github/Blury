# Dependencies
node_modules/

# Frontend build output
dist/
dist-ssr/
*.local

# Rust / Tauri build output.
# The installer is distributed through GitHub Releases, never committed.
target/
src-tauri/target/
app/src-tauri/target/

# Generated by Tauri: capability schemas for editor auto-completion.
gen/schemas/
app/src-tauri/gen/schemas/

# Local tooling config, specific to one machine
.claude/
.env
.env.*
.npmrc

# Internal development notes and workspace scaffolding. None of this is part of
# the published project; it stays on disk and out of the repo.
#
# Deliberately NOT here, despite being development files: .github/workflows,
# RELEASE_NOTES.md (the release workflow reads it), and everything under app/
# that builds the binary. Removing any of those breaks the build or the release.
CLAUDE.md
bubble-kickoff-prompt.md
docs/LAUNCH.md
docs/MAINTAINING.md
REPO_METADATA.md
app/IDEAS.md
.vscode/
app/.vscode/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS junk
.DS_Store
Thumbs.db
desktop.ini
